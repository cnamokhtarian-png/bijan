# ---- نمونه متغیرهای محیطی (این فایل را به .env کپی کنید) ----

# اتصال دیتابیس (Supabase / Postgres)
# قالب Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# حداکثر تعداد اتصال pool (پیش‌فرض ۵)
PG_POOL_MAX=5

# ---- اسکریپت ساخت حساب مدیر (npm run db:set-admin) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=مدیر دانش‌بوک
ADMIN_EMAIL_DOMAIN=daneshbook.local

# ---- seed (فقط دیتابیس توسعه؛ هرگز روی تولید اجرا نکنید) ----
SEED_PASSWORD=

# ---- ارسال ایمیل (بازیابی رمز عبور) ----
# بدون این کلید، ایمیل ارسال نمی‌شود و در محیط توسعه لینک در پاسخ/لاگ چاپ می‌شود.
RESEND_API_KEY=
MAIL_FROM=دانش‌بوک <no-reply@your-domain.com>

# آدرس عمومی سایت — برای لینک ایمیل، canonical، sitemap و og:url الزامی است
# مثال: NEXT_PUBLIC_SITE_URL=https://daneshbook.ir
NEXT_PUBLIC_SITE_URL=

# کد تأیید Google Search Console (متا تگ verification)
GOOGLE_SITE_VERIFICATION=

# ---- ساخت دستی لینک بازیابی (npm run reset-link) ----
SITE_URL=

# ---- بازی «بیژن» (صفحه‌ی /bijan) ----
# به‌طور پیش‌فرض بازی از فایل داخلی public/games/bijan/index.html سرو می‌شود.
# اگر بازی روی دامنه‌ی دیگری میزبانی شد (مثلاً نسخه‌ی Vercel همان ریپو)، آدرس
# کامل آن را اینجا بگذارید. مثال:
# BIJAN_GAME_URL=https://bijan-game.vercel.app
BIJAN_GAME_URL=
